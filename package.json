{
  "name": "kiebitz",
  "private": true,
  "version": "1.3.2",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://kiebitz.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiebitz-dev/Kiebitz.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "pins:sync": "node scripts/generate-stockfish-notice.mjs",
    "pins:check": "node scripts/generate-stockfish-notice.mjs --check && node scripts/check-toolchain-pin-consumers.mjs",
    "pieces:sync": "node scripts/generate-piece-glyphs.mjs && node scripts/generate-vendor-pieces.mjs",
    "pieces:check": "node scripts/generate-piece-glyphs.mjs --check && node scripts/generate-vendor-pieces.mjs --check",
    "share:sync": "node scripts/sync-share-codec.mjs",
    "share:check": "node scripts/sync-share-codec.mjs --check",
    "vectors:sync": "node scripts/make-share-vectors.mjs",
    "vectors:check": "node scripts/make-share-vectors.mjs --check",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "store-assets:marketing": "python scripts/compose-store-assets-v3.py artifacts/store-assets artifacts/store-assets-v3 artifacts/Kiebitz-Play-Store-Assets-v3.zip",
    "locales:check": "node scripts/check-locales.mjs",
    "themes:check": "node scripts/check-theme-contrast.mjs",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "openings:generate": "node scripts/generate-opening-names.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "chess.js": "^1.0.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
