{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kiebitz",
  "version": "1.3.0",
  "identifier": "de.torim.kiebitz",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kiebitz",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0e0e0d",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/stockfish.exe",
      "resources/stockfish/NOTICE.txt",
      "resources/stockfish/COPYING.txt",
      "resources/licenses/THIRD_PARTY_LICENSES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": ["English", "German"]
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["kiebitz"]
        }
      ],
      "desktop": {
        "schemes": ["kiebitz"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2N0I0OUI5MEUyRUE0NTIKUldSU3BDNE91VWw3MXM3QVdnVFRtNTVOZDgralo3SklaNXVicEMraUpTNzA5eDJMS0Ixd213bXIK",
      "endpoints": [
        "https://github.com/kiebitz-dev/Kiebitz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
